[
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_inline_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', 'FAKE-key-0123456789abcdef'), body := '{}'::jsonb)"
  },
  {
    "rule": "app-guc",
    "jobname": "fixture_guc_job",
    "command": "SELECT net.http_post(url := current_setting('app.analytics_service_url', true) || '/a')"
  },
  {
    "rule": "vault-absent",
    "jobname": "match_engine_cron",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', body := '{}'::jsonb)"
  },
  {
    "rule": "pg-password",
    "jobname": "fixture_dblink_job",
    "command": "SELECT dblink_connect('host=db.invalid user=postgres password=FAKEPASSWORD')"
  },
  {
    "rule": "authorization-literal",
    "jobname": "fixture_authz_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('Authorization', 'Basic RkFLRTpGQUtFRkFLRUZBS0U='), body := '{}'::jsonb)"
  },
  {
    "rule": "bearer-literal",
    "jobname": "fixture_bearer_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Auth', 'Bearer FAKEtoken0123456789'), body := '{}'::jsonb)"
  },
  {
    "rule": "apikey-literal",
    "jobname": "fixture_apikey_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('apikey', 'FAKE-anon-key-0123456789'), body := '{}'::jsonb)"
  },
  {
    "rule": "service-role",
    "jobname": "fixture_role_job",
    "command": "SELECT set_config('role', 'service_role', false)"
  },
  {
    "rule": "jwt-shape",
    "jobname": "fixture_jwt_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a?token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkZBS0UifQ')"
  },
  {
    "rule": "long-literal-in-headers",
    "jobname": "fixture_longlit_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Trace', 'FAKE-0123456789-0123456789-0123456789'), body := '{}'::jsonb)"
  },
  {
    "rule": "header-unparseable",
    "jobname": "fixture_unbalanced_headers_job",
    "note": "THE VALUE IS LONG ON PURPOSE — it derives 37 characters, over HEADERS_LITERAL_MAX. Shorten it and this row stops distinguishing the header walks SKIPPING an unparseable region from them walking it: with a short value both spellings return only [header-unparseable], so the skip becomes a control that cannot fail. Split into short operands so gitleaks sees no credential-shaped token.",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Trace', 'FAKE-trace-' || '012345' || '6789ab' || '01234567' || '89abcd'"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_split_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', 'FAKE-key-' || '012345' || '6789ab'), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_concat_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', concat('FAKE-key-','012345','6789ab')), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_format_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', format('%s%s%s','FAKE-key-','012345','6789ab')), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_chr_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', chr(65)||chr(66)||chr(67)||chr(68)||chr(69)||chr(70)||chr(71)||chr(72)||chr(73)||chr(74)||chr(75)||chr(76)||chr(77)||chr(78)||chr(79)||chr(80)), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_decode_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', convert_from(decode('RkFLRS1rZXktMDE=','base64'),'utf8')), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_quote_literal_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', quote_literal('FAKE-key-0123456789ab')), body := '{}'::jsonb)"
  },
  {
    "rule": "x-service-key-literal",
    "jobname": "fixture_dollar_quoted_key_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', $q$FAKE-key-0123456789ab$q$), body := '{}'::jsonb)"
  },
  {
    "rule": "long-literal-in-headers",
    "jobname": "fixture_nonanchored_split_job",
    "command": "SELECT net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Auth', 'FAKE-key-0123456789' || 'abcdef0123456789'), body := '{}'::jsonb)"
  },
  {
    "rule": "pg-password",
    "jobname": "fixture_plpgsql_pw_job",
    "command": "DO $$ DECLARE v_password text; BEGIN v_password := 'FAKEpw'; END $$"
  },
  {
    "rule": "pg-password",
    "jobname": "fixture_libpq_uri_job",
    "command": "SELECT dblink_connect('postgres://u:FAKEpw@db.invalid/db')"
  },
  {
    "rule": "pg-password",
    "jobname": "fixture_pgpassword_colon_job",
    "command": "SELECT set_config('x', 'PGPASSWORD: FAKEpw', false)"
  },
  {
    "rule": "long-token-anywhere",
    "jobname": "fixture_var_key_job",
    "note": "BYPASS (h) AS A RED ROW. The header VALUE is a plpgsql VARIABLE, so every header-anchored rule has nothing to measure and this row fires long-token-anywhere ALONE — which is what makes it attributable. The literal sits OUTSIDE any header region: that is the Q2 partition working, not luck. Assembled from short operands so no credential-shaped token is typed whole into a public repo.",
    "command": "DO $$ DECLARE k text; BEGIN k := 'FAKE-0123456789-0123456789-0123456789ab'; PERFORM net.http_post(url := 'https://x.invalid/a', headers := jsonb_build_object('X-Service-Key', k), body := '{}'::jsonb); END $$"
  }
]
