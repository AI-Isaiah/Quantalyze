{
  "name": "quantalyze",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/.eslintcache src/ && tsx scripts/check-admin-route-manifest.ts && tsx scripts/check-route-contract.ts && tsx scripts/check-planning-hygiene.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "test:local-stack": "vitest run --config vitest.local-stack.config.ts",
    "test:e2e": "playwright test",
    "verify:phase18": "tsx scripts/verify-phase18-artifacts.ts",
    "check:founder-lp-readiness": "tsx scripts/check-founder-lp-readiness.ts",
    "check:admin-route-manifest": "tsx scripts/check-admin-route-manifest.ts",
    "check:route-contract": "tsx scripts/check-route-contract.ts",
    "check:planning-hygiene": "tsx scripts/check-planning-hygiene.ts",
    "worker:dev": "cd analytics-service && .venv/bin/python main_worker.py",
    "schema:functions": "tsx scripts/dump-sql-functions.ts",
    "schema:functions:check": "tsx scripts/dump-sql-functions.ts --check"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@sentry/nextjs": "^10.73.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.110.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.4",
    "posthog-js": "^1.427.2",
    "posthog-node": "^5.51.6",
    "puppeteer-core": "^25.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "svix": "^1.96.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^4.1.2",
    "ws": "^8.21.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.23"
  },
  "version": "0.77.19.0"
}
