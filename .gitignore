# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest blob reports (sharded coverage merge — CI artifact, never committed)
/.vitest-reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Phase 12 / M-01: phase12_deploy.py writes TRADE_MIX_HAS_MAKER_TAKER here for CI
# parity tests to source. Listed explicitly so grep -E "^\.env\.test$" matches the
# Phase 12 Plan 12-10 acceptance contract (the .env* glob above already covers it).
.env.test

# vercel
.vercel

# gstack security reports and local state
.gstack/

# Claude Code local session state (settings.local.json, worktrees, locks) —
# genuinely per-developer, never in the repo.
.claude/

# .planning/ is TRACKED (GSD default: planning.commit_docs = true). It was
# gitignored on 2026-04-17 (16f1ab17) for gstack, whose model treated planning
# as per-developer scratch; GSD's model is the opposite — plans, summaries and
# validation ledgers are project history. Keeping the gstack line cost us three
# things: executor worktrees could not read their own PLAN.md (so waves ran
# sequentially and lost their entire purpose), the ledgers had no git backup
# (a bad sed truncated ROADMAP.md with nothing to restore from, and `git
# checkout` silently deletes untracked ledgers), and we inherited upstream bug
# classes that only exist in the gitignored configuration
# (gsd-build/get-shit-done#2838 destroyed SUMMARY.md files exactly this way).
# Key-shaped strings in these markdowns are redaction-test fixtures and are
# allowlisted by path in .gitleaks.toml.
# Session-scoped workstream pointer is local state, not history:
.planning/active-workstream

# Per-developer AI scratchpads (ADVERSARIAL_USER_NOTES.md etc.) — never committed.
tasks/

# supabase CLI local state
supabase/.temp/

# Filled-in pitch / demo templates contain sensitive partner + allocator info.
# Templates are committed as *.template.md; the bare .md is the filled-in copy
# the founder edits locally and never commits to a public repo.
docs/pitch/partner-qualification-notes.md
docs/demos/before-metric.md
docs/demos/before-after.md

# python
__pycache__/
*.pyc
.coverage
*.venv/

# playwright
.playwright-mcp/
/test-results/
/playwright-report/

# Phase 48-05 / A11Y-03: @lhci/cli writes its run output (HTML/JSON Lighthouse
# reports + link records) here on every `lhci autorun`. Runtime artifact only —
# the budget config is lighthouserc.json (committed); this dir is never committed.
.lighthouseci/

# screenshots and docs at repo root
*.png
*.docx
# ...but commit Playwright snapshot baselines — they ARE the contract the
# screenshot regression suite asserts against. C-0300 sentinel
# (e2e/demo-screenshot.spec.ts:24) fails CI if any of these PNGs are
# missing; without the allow rule below they were silently ignored.
!e2e/**/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state (linked project metadata)
analytics-service/supabase/
.env*.local
fix-list.md

# audit-fix campaign working artifacts — per-developer tooling, never in the repo
# (mirrors .planning/ and fix-list.md above).
fix-list-cluster.md
fix-list-cluster.md.bak*
.review/
tool-results/
scripts/audit-close-findings.py
scripts/extract-fixlist-section.sh
scripts/mark-reverified-closed.py

# GSD runtime sentinel — machine-written, timestamped, not source
.gsd/
