{
  "_comment": "Cross-runtime oracle for the BTC-native -> USD return conversion (Phase 164.6.6.2 D-18, D-22, D-23). Read by src/lib/factsheet/native-to-usd.test.ts and by the Python twin built in plan 164.6.6.2-13. Every `expected` value is a HAND-COMPUTED literal (see each `arithmetic`), never produced by either implementation. usd_k = (1 + r_k) * (1 + btc_k) - 1, where r_k is the account's BTC-denominated daily return and btc_k the BTC close-to-close move over the same interval. A `null` series value stands for a non-finite number (JSON has no NaN).",
  "tolerance": 1e-12,
  "cases": [
    {
      "name": "two_day_blend_is_021_not_raw_btc_010",
      "unit": "BTC",
      "closes": { "2026-02-02": 60000, "2026-02-03": 66000 },
      "dropped": [],
      "series": [
        { "date": "2026-02-02", "value": 0.05 },
        { "date": "2026-02-03", "value": 0.1 }
      ],
      "expected": [{ "date": "2026-02-03", "value": 0.21 }],
      "arithmetic": "BTC NAV 1.0 -> 1.1 (r = 0.10); USD value (1.1 x 66000) / (1.0 x 60000) - 1 = 72600 / 60000 - 1 = 1.21 - 1 = 0.21. Raw BTC blend would be 0.10."
    },
    {
      "name": "three_day_blend_up_then_down",
      "unit": "BTC",
      "closes": { "2026-02-02": 50000, "2026-02-03": 55000, "2026-02-04": 60500 },
      "dropped": [],
      "series": [
        { "date": "2026-02-02", "value": 0.0 },
        { "date": "2026-02-03", "value": 0.1 },
        { "date": "2026-02-04", "value": -0.1 }
      ],
      "expected": [
        { "date": "2026-02-03", "value": 0.21 },
        { "date": "2026-02-04", "value": -0.01 }
      ],
      "arithmetic": "BTC NAV 1.0, 1.1, 0.99. day1: (1.1 x 55000) / (1.0 x 50000) - 1 = 60500 / 50000 - 1 = 0.21. day2: (0.99 x 60500) / (1.1 x 55000) - 1 = 59895 / 60500 - 1 = -0.01."
    },
    {
      "name": "distinct_account_and_btc_moves",
      "unit": "BTC",
      "closes": { "2026-02-02": 40000, "2026-02-03": 44000 },
      "dropped": [],
      "series": [
        { "date": "2026-02-02", "value": 0.0 },
        { "date": "2026-02-03", "value": 0.25 }
      ],
      "expected": [{ "date": "2026-02-03", "value": 0.375 }],
      "arithmetic": "BTC NAV 2.0 -> 2.5 (r = 0.25); BTC 40000 -> 44000 (+0.10). USD (2.5 x 44000) / (2.0 x 40000) - 1 = 110000 / 80000 - 1 = 1.375 - 1 = 0.375."
    },
    {
      "name": "weekday_series_spans_a_weekend_with_all_closes",
      "unit": "BTC",
      "closes": {
        "2026-01-02": 100,
        "2026-01-03": 110,
        "2026-01-04": 121,
        "2026-01-05": 133.1
      },
      "dropped": [],
      "series": [
        { "date": "2026-01-02", "value": 0.0 },
        { "date": "2026-01-05", "value": 0.1 }
      ],
      "expected": [{ "date": "2026-01-05", "value": 0.4641 }],
      "arithmetic": "Fri 2026-01-02 to Mon 2026-01-05 covers three BTC days: 1.1 x 1.1 x 1.1 = 1.331 (133.1 / 100). r = 0.10. USD 1.1 x 1.331 - 1 = 1.4641 - 1 = 0.4641."
    }
  ]
}
