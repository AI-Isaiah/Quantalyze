        {"id": "k-dep", "exchange": "binance", "venue_account_id": "acct-2", "disconnected_at": "2026-06-10T15:30:00+00:00", "sync_status": "complete", "history_inclusion": null, "first_returns_day": "2026-06-01", "last_returns_day": "2026-06-12"}
